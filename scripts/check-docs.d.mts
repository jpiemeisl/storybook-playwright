type Problem = { file: string; line: number; rule: string; message: string };
type Doc = { file: string; text: string };
type Line = { line: number; text: string; inFence: boolean; fenceStart?: boolean; fenceEnd?: boolean; info?: string };
export const EXCLUDED_DIRS: Set<string>;
export const HISTORY_FILES: Set<string>;
export const GENERATED_FILES: Set<string>;
export const REPO_PATH: RegExp;
export function scanLines(markdown: string): Line[];
export function withoutInlineCode(text: string): string;
export function inlineCode(text: string): string[];
export function slug(heading: string): string;
export function anchors(markdown: string): Set<string>;
export function links(text: string): { target: string; image: boolean }[];
export function isExternal(target: string): boolean;
export function checkLinks(doc: Doc, io: { exists: (path: string) => boolean; read: (path: string) => string | null }): Problem[];
export function checkScripts(doc: Doc, options: { scripts: Set<string>; allowed?: Set<string> }): Problem[];
export function repoPath(span: string): string | null;
