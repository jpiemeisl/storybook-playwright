export const VERSION_PATTERNS: [RegExp, string][];
export function currentVersionPatterns(current: [string, string][]): [RegExp, string][];
export function checkVersions(doc: Doc, current?: [string, string][]): Problem[];
export function typecheckExamples(blocks: { file: string; line: number; lang: string; code: string }[], root: string): Problem[];
export function markdownFiles(root: string, dir?: string): string[];
export function externalLinks(file: string, text: string): { file: string; line: number; url: string }[];
export const SKIP_HOSTS: RegExp;
