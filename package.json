{
  "name": "@jpiemeisl/pattern-library",
  "version": "0.1.0",
  "description": "React pattern library for content and commerce sites: components, page templates, design tokens and themes.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpiemeisl/storybook-playwright.git"
  },
  "homepage": "https://github.com/jpiemeisl/storybook-playwright#readme",
  "bugs": {
    "url": "https://github.com/jpiemeisl/storybook-playwright/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/core.js"
    },
    "./commerce": {
      "types": "./dist/types/commerce/index.d.ts",
      "import": "./dist/commerce.js"
    },
    "./core.css": "./dist/core.css",
    "./commerce.css": "./dist/commerce.css",
    "./tokens.css": "./dist/tokens/index.css",
    "./tokens/*": "./dist/tokens/*",
    "./themes/harbor.css": "./dist/tokens/themes/harbor.css",
    "./themes/orchard.css": "./dist/tokens/themes/orchard.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/core.js",
    "dist/core.css",
    "dist/commerce.js",
    "dist/commerce.css",
    "dist/tokens/",
    "dist/types/",
    "CHANGELOG.md",
    "docs/consuming.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:vrt": "node scripts/vrt-guard.mjs check && storybook build && playwright test",
    "test:vrt:update": "node scripts/vrt-guard.mjs update && storybook build && playwright test --update-snapshots",
    "test:vrt:report": "playwright show-report",
    "docker:pull": "node scripts/docker-run.mjs --pull",
    "docker:shell": "node scripts/docker-run.mjs --shell",
    "test:vrt:docker": "node scripts/docker-run.mjs npm run test:vrt --",
    "test:vrt:docker:update": "node scripts/docker-run.mjs npm run test:vrt:update --",
    "test:vrt:docker:smoke": "node scripts/docker-run.mjs npm run test:vrt:smoke --",
    "test:a11y:docker": "node scripts/docker-run.mjs npm run test:a11y --",
    "test:vrt:smoke": "node scripts/vrt-guard.mjs check && storybook build && playwright test --config playwright.smoke.config.ts",
    "test:vrt:changed": "storybook build && playwright test --grep",
    "test:vrt:flaky": "playwright test --repeat-each=5 --retries=0 --grep",
    "test:unit": "vitest run",
    "docs:content-model": "node scripts/content-model-docs.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:story-tags": "node scripts/check-story-tags.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:themes": "node scripts/check-theme-contract.mjs",
    "test:a11y": "storybook build && playwright test --config playwright.a11y.config.ts",
    "build:lib": "vite build -c vite.lib.config.ts && vite build -c vite.lib.config.ts --mode commerce && node scripts/copy-lib-css.mjs && tsc -p tsconfig.lib.json",
    "check:lib": "node scripts/check-lib.mjs",
    "docs:components": "node scripts/components-docs.mjs",
    "check:all": "npm run typecheck && npm run check:playwright-image && npm run check:boundaries && npm run check:tokens && npm run check:themes && npm run build-storybook && npm run check:story-tags && npm run check:snapshots && npm run docs:components -- --check && npm run build:lib && npm run check:lib && npm run check:package && npm run check:api && npm run test:unit",
    "check:playwright-image": "node scripts/check-playwright-image.mjs",
    "check:snapshots": "node scripts/check-orphan-snapshots.mjs",
    "prepublishOnly": "node scripts/release-guard.mjs",
    "check:package": "node scripts/check-package.mjs",
    "api:report": "node scripts/api-report.mjs",
    "check:api": "node scripts/api-report.mjs --check",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:tag": "node scripts/release-tag.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "http-server": "^14.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
